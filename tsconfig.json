{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@global.css": ["./global.css"],
      "@/constants/*": ["./constants/*"],
      "@/lib/*": ["./lib/*"]

    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}